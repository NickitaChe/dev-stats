{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-stats",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "routes": [
    {
      "pattern": "stats.nickitache.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "STATS"
    }
  ]
}
